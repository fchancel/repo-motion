# repo-motion runs with no configuration. Every variable below is optional.

# Where projects and their briefs are stored (default: ~/.repo-motion).
# REPO_MOTION_HOME=

# The Claude Code executable (default: "claude" from your PATH, then ~/.local/bin/claude).
# REPO_MOTION_CLAUDE_BIN=

# Model used for analyses (default: the one configured in your Claude Code).
# REPO_MOTION_MODEL=

# How long an analysis may run before it is stopped, in minutes (default: 20).
# REPO_MOTION_ANALYSIS_TIMEOUT_MINUTES=

# How long a video may render before it is stopped, in minutes (default: 15).
# REPO_MOTION_RENDER_TIMEOUT_MINUTES=

# The script that renders a video (default: packages/video/render.mjs of this repository).
# REPO_MOTION_RENDER_SCRIPT=

# How long Claude may work on directing one video, in minutes (default: 45).
# REPO_MOTION_DIRECTOR_TIMEOUT_MINUTES=
